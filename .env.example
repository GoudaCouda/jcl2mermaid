# =====================================================================
# jcl2mermaid Configuration Defaults
# =====================================================================

# Download method to retrieve JCL: ftp, ssh, zowe, or local
DOWNLOAD_METHOD=ftp

# Mainframe / Remote host details
DOWNLOAD_HOSTNAME=mainframe.example.com
DOWNLOAD_USERNAME=YOUR_USER
DOWNLOAD_PASSWORD=YOUR_PASSWORD

# Default diagram engine / format: mermaid, d2, or graphviz
DESIGN_TYPE=mermaid